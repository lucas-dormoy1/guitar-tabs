{
  "expo": {
    "name": "GuitarTabs",
    "slug": "guitar-tabs",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lucasdormoy.guitartabs",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14161A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "guitartabs",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F1F2F5"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bd6e71f-00bd-4d75-bedd-b437f15e14e9"
      }
    },
    "owner": "mimiche"
  }
}
