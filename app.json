{
  "expo": {
    "name": "GuitarTabs",
    "slug": "guitar-tabs",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.lucasdormoy.guitartabs",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "guitartabs",
    "plugins": ["expo-router", "expo-font"]
  }
}
